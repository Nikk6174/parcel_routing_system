# ── Server ────────────────────────────────────────────
PORT=3001

# ── MongoDB (REQUIRED — app will not start without this) ─
MONGO_URI=mongodb://localhost:27017/parcel-routing

# ── Logging ───────────────────────────────────────────
# Valid values: debug, info, warn, error
LOG_LEVEL=info

# ── Rate Limiting ─────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
